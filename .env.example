# Copy to .env.local (never commit real keys). Everything is optional:
# without keys the app runs in demo mode (archive answers + browser voice/subtitles).

# --- AI Q&A (server-side only) ---
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
AI_MODEL=

# --- Text-to-speech (configure ONE provider) ---
# TTS_PROVIDER=azure | google   (auto-detected when unset)
TTS_PROVIDER=
# Azure AI Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Google Cloud Text-to-Speech (API key restricted to the TTS API)
GOOGLE_TTS_API_KEY=
# Voice names — verify against the provider's current voice list before deploying.
# Azure defaults: vi-VN-HoaiMyNeural / en-US-JennyNeural. Google: leave empty to let it pick a female voice.
TTS_VOICE_VI=
TTS_VOICE_EN=
