# Copy to .env (or .env.local) — never commit real keys. On Vercel, add the same variables under
# Project → Settings → Environment Variables (Production + Preview); the local .env is not uploaded.
# Without keys the app still runs: archive answers + browser voice / subtitles.

# --- AI Q&A (server-side only) ---
# AI_PROVIDER=gemini | anthropic   (auto: Gemini when GEMINI_API_KEY is set, else Anthropic)
AI_PROVIDER=
GEMINI_API_KEY=
# Main model, then comma-separated fallbacks tried when one is overloaded / rate-limited / times out
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest
ANTHROPIC_API_KEY=
AI_MODEL=

# --- Text-to-speech: ElevenLabs (default) ---
# API key needs the "Text to Speech" permission ("Voices: read" helps to look up voice IDs).
ELEVENLABS_API_KEY=
# Vietnamese voice. "Trang - Clear, Smooth and Direct" = BlZK9tHPU6XXjwOSIiYA (Voice Library voices
# need a paid plan via the API). On the Free plan use an account voice, e.g. Alice = Xb7hH8MSUJpSbSDYk0k2.
ELEVENLABS_VOICE_ID_VI=Xb7hH8MSUJpSbSDYk0k2
# English female voice: Sarah
ELEVENLABS_VOICE_ID_EN=EXAVITQu4vr4xnSDxMaL
# eleven_v3 supports expressive audio tags (used for Vietnamese); flash is fastest (English)
ELEVENLABS_MODEL_VI=eleven_v3
ELEVENLABS_MODEL_EN=eleven_flash_v2_5

# --- Other TTS providers (optional) ---
# TTS_PROVIDER=elevenlabs | azure | google
TTS_PROVIDER=elevenlabs
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_TTS_API_KEY=
# Azure / Google voice names
TTS_VOICE_VI=
TTS_VOICE_EN=
