# Copy to .env (or .env.local) — never commit real keys. Everything is optional:
# without an AI key the app runs in demo mode (archive answers); without Python the voice falls back
# to the browser voice / subtitles.

# --- AI Q&A (server-side only) ---
# AI_PROVIDER=gemini | anthropic   (auto: Gemini when GEMINI_API_KEY is set, else Anthropic)
AI_PROVIDER=
GEMINI_API_KEY=
# Main model, then comma-separated fallbacks tried when one is overloaded / rate-limited / times out
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest
ANTHROPIC_API_KEY=
AI_MODEL=

# --- Text-to-speech ---
# edge  = free Microsoft Edge voices through the Python `edge-tts` library (no key; needs Python + Internet):
#         python -m venv .venv && .venv/Scripts/pip install -r requirements.txt   (Windows)
#         python3 -m venv .venv && .venv/bin/pip install -r requirements.txt      (macOS/Linux)
# azure | google = paid providers (keys below). Unset: azure/google if keyed, otherwise edge.
TTS_PROVIDER=edge
# Python that has edge-tts installed; empty = ./.venv, else python on PATH
EDGE_TTS_PYTHON=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_TTS_API_KEY=
# Female voices (verified in the edge-tts voice list)
TTS_VOICE_VI=vi-VN-HoaiMyNeural
TTS_VOICE_EN=en-US-JennyNeural
