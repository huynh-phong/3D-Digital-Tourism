# Copy to .env (or .env.local) — never commit real keys. On Vercel, add the same variables under
# Project → Settings → Environment Variables (Production + Preview); the local .env is not uploaded.
# Without keys the app still runs: archive answers + subtitles.

# --- AI Q&A (server-side only) ---
# AI_PROVIDER=gemini | anthropic   (auto: Gemini when GEMINI_API_KEY is set, else Anthropic)
AI_PROVIDER=
GEMINI_API_KEY=
# Main model, then comma-separated fallbacks tried when one is overloaded / rate-limited / times out
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest
ANTHROPIC_API_KEY=
AI_MODEL=

# --- Voice ---
# TTS_PROVIDER=azure | elevenlabs   (auto: Azure when its key is set, else ElevenLabs)
TTS_PROVIDER=azure

# Azure AI Speech (default): native voices, one per language. Free tier F0 is enough for a demo.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_VOICE_VI=vi-VN-HoaiMyNeural
AZURE_VOICE_EN=en-US-JennyNeural

# ElevenLabs (alternative): one voice for both languages
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5
